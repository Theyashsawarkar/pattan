#!/usr/bin/env bash
# Runs pattan for the tmux plugin: the one on PATH, else the copy built in
# this plugin's folder (bin/pattan), building it with Go the first time.
dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# tmux's environment often lacks ~/.local/bin and ~/go/bin: look there too
for bin in "$(command -v pattan 2>/dev/null)" "$HOME/.local/bin/pattan" "${GOBIN:-$HOME/go/bin}/pattan"; do
  if [ -n "$bin" ] && [ -x "$bin" ]; then exec "$bin" "$@"; fi
done
# the copy built here: rebuilt whenever the plugin's code is newer (TPM update)
stale() { [ ! -x "$dir/bin/pattan" ] || [ -n "$(find "$dir/cmd" "$dir/internal" "$dir/go.mod" -newer "$dir/bin/pattan" -print -quit 2>/dev/null)" ]; }
if stale; then
  if command -v go >/dev/null 2>&1; then
    echo "Building pattan..."
    (cd "$dir" && go build -trimpath -o bin/pattan ./cmd/pattan) || { echo "Build failed."; read -rn1; exit 1; }
  else
    echo "pattan isn't installed: see https://github.com/Theyashsawarkar/pattan#install"
    echo "(press a key)"; read -rn1; exit 1
  fi
fi
exec "$dir/bin/pattan" "$@"
